root = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
insert_final_newline = true
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable
max_line_length = 100
trim_trailing_whitespace = true

[*.{md,rs,toml,xml}]
insert_final_newline = true
trim_trailing_whitespace = true
